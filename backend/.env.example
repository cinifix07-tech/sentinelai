# PostgreSQL is legacy-only during the migration. New authentication and IoT
# writes use Convex; do not add these values to Vercel.
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_SSL=false
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
PORT=4000
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://192.168.0.109:5173,http://192.168.0.109:5174
BCRYPT_ROUNDS=10
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.gmail@gmail.com
SMTP_PASS=your_16_character_google_app_password
SMTP_FROM=Sentinel AI <your.gmail@gmail.com>
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5-mini
XIAOZHI_MCP_URL=wss://api.xiaozhi.me/mcp/?token=replace_me
IOT_DEVICE_API_KEY=replace_me
CONVEX_SITE_URL=https://your-deployment.convex.site
CONVEX_CONTROL_TOKEN=generate_a_private_backend_only_token
# Development only. Keep false or unset in production.
ALLOW_DEV_FALLBACK_AUTH=false
